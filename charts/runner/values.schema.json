{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["config", "existingSecret", "image", "podIdentity"],
  "properties": {
    "nameOverride": { "$ref": "#/$defs/dnsLabel" },
    "fullnameOverride": { "$ref": "#/$defs/dnsLabel" },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runnerId", "apiUrl"],
      "properties": {
        "runnerId": { "type": "string", "minLength": 1 },
        "apiUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s\"]+$"
        },
        "debug": { "type": "boolean" }
      }
    },
    "extraEnv": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "not": {
          "pattern": "(?i)(^|_)(TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIALS?|API_KEY|ACCESS_KEY|PRIVATE_KEY)(_|$)"
        }
      },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "command": { "type": "string", "enum": ["install", "org"] },
    "existingSecret": { "type": "string", "minLength": 1 },
    "existingSecretKey": { "type": "string", "minLength": 1 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9._-]*[a-z0-9])?(:[0-9]+)?(/[a-z0-9]([a-z0-9._-]*[a-z0-9])?)*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "tag": {
          "type": "string",
          "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "podIdentity": {
      "type": "object",
      "required": ["existingServiceAccount"],
      "properties": {
        "existingServiceAccount": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "node_pool": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "expireAfter": {
          "type": "string",
          "pattern": "^(Never|([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+)$"
        },
        "node_class_ref": {
          "type": "object",
          "properties": {
            "group": { "$ref": "#/$defs/dnsSubdomain" },
            "kind": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
            "name": { "$ref": "#/$defs/dnsSubdomain" }
          }
        },
        "capacity_types": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["on-demand", "spot", "reserved"] }
        },
        "instance_type": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
            "cpu": { "type": "integer", "minimum": 1 },
            "memory": { "type": "integer", "minimum": 1 }
          }
        },
        "runner_count": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
    },
    "dnsSubdomain": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    }
  }
}
